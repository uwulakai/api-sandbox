POSTGRES_VERSION=16-alpine
POSTGRES_DB_NAME=api_sandbox
POSTGRES_USER=api_sandbox
POSTGRES_PASSWORD=change-me

# Local frontend port, bound to 127.0.0.1.
FRONTEND_HTTP_PORT=8893

# Use the public HTTPS frontend URL in Dokploy.
FRONTEND_PUBLIC_URL=https://apisandbox.mnrg.tech/
SMTP_HOSTNAME=smtp.yandex.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=8
EMAIL_VERIFICATION_TTL_MINUTES=30
EMAIL_VERIFICATION_RESEND_SECONDS=60

MOCK_RUNTIME_IMAGE=api-sandbox/mock-runtime:dev
PUBLIC_NETWORK_NAME=api-sandbox-public
# Traefik's shared network: dokploy-network for standard deployments.
# With Dokploy Isolated Deployments, use the project's exact network name.
TRAEFIK_DOCKER_NETWORK=dokploy-network
# Local Docker URL. In Dokploy, set the public HTTPS gateway URL.
MOCK_PUBLIC_BASE_URL=http://mock_gateway:8080
MOCK_RUNTIME_PORT=8080
MOCK_RUNTIME_CONTAINER_PREFIX=api-sandbox-mock-

# Jenkins / live E2E tests
API_BASE_URL=https://api.apisandbox.mnrg.tech
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=replace-with-strong-secret
E2E_WAIT_SECONDS=90
E2E_CRON=
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_OTHER_EMAIL=
E2E_OTHER_PASSWORD=
